# -----------------------------------------------------------------------------
# Flask settings
# -----------------------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# -----------------------------------------------------------------------------
# MQTT broker settings
# -----------------------------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE_SECONDS=60
MQTT_TOPIC_FILTER=cvut/nsi/2026/+/telemetry
MQTT_LED_COMMAND_TOPIC=cvut/nsi/2026/device01/led
MQTT_TELEMETRY_TOPIC=cvut/nsi/2026/device01/telemetry
MQTT_STATUS_TOPIC=cvut/nsi/2026/device01/status
MQTT_PERIOD_COMMAND_TOPIC=cvut/nsi/2026/device01/period

# Centralized topic fragments (optional):
# MQTT_TOPIC_PREFIX + <device> + MQTT_TOPIC_TELEMETRY_SUFFIX
MQTT_TOPIC_PREFIX=cvut/nsi/2026/
MQTT_TOPIC_TELEMETRY_SUFFIX=/telemetry

# -----------------------------------------------------------------------------
# SQLite database settings
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=telemetry.sqlite3
SQLITE_SCHEMA_PATH=schema.sql

# -----------------------------------------------------------------------------
# Frontend polling settings (milliseconds)
# -----------------------------------------------------------------------------
FRONTEND_REFRESH_MS=2000

# -----------------------------------------------------------------------------
# API routes (optional override)
# -----------------------------------------------------------------------------
ROUTE_DASHBOARD=/
ROUTE_LATEST=/api/latest
ROUTE_LED_COMMAND=/api/commands/led
ROUTE_TEMPERATURE_TEST=/api/commands/test-temperature
ROUTE_UPDATE_TELEMETRY_PERIOD=/update_telemetry_period

# Telemetry publish period limits (seconds)
TELEMETRY_PERIOD_MIN_SECONDS=1
TELEMETRY_PERIOD_MAX_SECONDS=300

# Allowed LED commands as comma-separated values
ALLOWED_LED_COMMANDS=ON,OFF,TOGGLE
